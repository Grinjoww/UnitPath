  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CinematicaIntro
  panelIntro: {fileID: 234806581}
  imagenVisualizador: {fileID: 1251415108}
  textoHistoria: {fileID: 1466087242}
  imagenes:
  - {fileID: 21300000, guid: df1bf3c99dc3f944f8ef15c0790a0e47, type: 3}
  - {fileID: 21300000, guid: a294cb997f51f1e4dbb9b5cefd56572c, type: 3}
  - {fileID: 21300000, guid: 20cef503803f46c43872f791b32661ee, type: 3}
  - {fileID: 21300000, guid: 4cbf0428ca41af3449220df4658153fe, type: 3}
  textos:
  - "Dicen que lo m\xE1s dif\xEDcil es lograr entrar a la universidad. Mentira."
  - "No pod\xEDa arriesgarme a que las muestras se regaran sobre mis documentos de
    matr\xEDcula..."
  - "Pero ahora tengo que cruzar todo el campus llevando esto en una fundita transparente
    sin que nadie se d\xE9 cuenta."
  - "Y para colmo... no tengo ni la menor idea de d\xF3nde queda el dispensario m\xE9dico."
  audioLatidos: {fileID: 972513460}
  audioAmbiente: {fileID: 43562700}
  statsJugador: {fileID: 0}
