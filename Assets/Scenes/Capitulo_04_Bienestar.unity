  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3efcb68f34f785e42a34fd0f482577a8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  miDialogo:
    nombre: Consejero
    retrato: {fileID: 21300000, guid: b1400670f9e4b9f43b20e0448a8428eb, type: 3}
    lineasInicio:
    - "\xBFTe puedo ayudar en algo?"
    opciones:
    - texto: "1. Justificaci\xF3n de faltas"
      respuesta:
      - Si tuviste problemas, podemos ayudarte
      - "Pero es importante que muestres una debida justificaci\xF3n"
    - texto: "2. Ayudant\xEDas econ\xF3micas"
      respuesta:
      - "Es para estudiantes que necesitan apoyo econ\xF3mico"
      - "Puede ser por tus califcaciones, por ser parte de comunidad o minor\xEDa"
      - "Tambi\xE9n por tu estado sociecon\xF3mico"
    - texto: "3. Tutor\xEDas acad\xE9micas"
      respuesta:
      - "Ofrecemos tutor\xEDas gratuitas"
      - "Puedes solicitar una tutor\xEDa siempre y cuando haya disponibilidad"
    - texto: 4. Nada, solo miraba
      respuesta: []
  distanciaInteraccion: 2
  textoInteraccion: {fileID: 709694541}
